    {
     "type": "compare",
     "title": "Tricky letters",
     "intro": "Comparisons with English only where the sound really matches. “No English equivalent” = learn the mouth position.",
     "items": [
      {
       "letter": "W w",
       "example": "der Wal",
       "en": "v — as in “very”",
       "mouth": "German *w* is never English *w*. Top teeth touch the lower lip."
      },
      {
       "letter": "V v",
       "example": "der Vogel",
       "en": "f — as in “father”",
       "mouth": "In most German words *v* = *f*. In some words from other languages (*die Vase*) it is like English *v*."
      },
      {
       "letter": "Z z",
       "example": "der Zug",
       "en": "ts — as in “cats”",
       "mouth": "Always *ts*, also at the start of a word."
      },
      {
       "letter": "J j",
       "example": "die Jacke",
       "en": "y — as in “yes”"
      },
      {
       "letter": "S s",
       "example": "die Sonne",
       "en": "z — as in “zoo”",
       "mouth": "Before a vowel, German *s* is voiced (buzzing)."
      },
      {
       "letter": "ß",
       "example": "die Straße",
       "en": "s — as in “see”",
       "mouth": "Always a sharp, voiceless *s*. Never *b*!"
      },
      {
       "letter": "Ä ä",
       "example": "der Bär",
       "en": "e — as in “bed” (here held longer)"
      },
      {
       "letter": "Ö ö",
       "example": "der Löwe",
       "none": true,
       "mouth": "Say German *e* (as in *See*), keep the tongue there and **round your lips** like for *o*."
      },
      {
       "letter": "Ü ü",
       "example": "die Tür",
       "none": true,
       "mouth": "Say *ee* (as in “see”), keep the tongue there and **round your lips tightly** like for *oo*."
      },
      {
       "letter": "R r",
       "example": "die Rose",
       "none": true,
       "mouth": "Made at the back of the throat, not with the tip of the tongue — a soft, light gargle. At the end of a word it often sounds like a short *a*: *der* ≈ “dea”."
      }
     ]
    },
