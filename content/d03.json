   "steps": [
    {
     "type": "video",
     "title": "Video: letter combinations (part 1)",
     "videoId": "nI77g2VWysE",
     "channel": "YourGermanTeacher (Johannes)",
     "start": 38,
     "end": 417,
     "note": "Chapters: 0:40 **ie / ei** · 1:47 **au / eu / äu** · 2:43 vowel + h · 3:17 **aa / ee / oo** · 3:53 double consonants · 4:32 **sch / ch / ck**.\n\nRepeat every example word after Johannes."
    },
    {
     "type": "compare",
     "title": "Combinations vs English",
     "intro": "Compared with English only where the sound really matches.",
     "items": [
      {
       "letter": "ie",
       "example": "das Bier",
       "en": "ee — as in “see”",
       "mouth": "*ie* is a long *ee*. Don't mix it up with *ei* (“eye”). *lieben, sie, Bier*."
      },
      {
       "letter": "ei",
       "example": "klein",
       "en": "eye — as in “my”",
       "mouth": "*ei* sounds like the English word *eye*. *heißen, klein*."
      },
      {
       "letter": "au",
       "example": "das Auto",
       "en": "ow — as in “how”",
       "mouth": "*bauen, laut, Auto*."
      },
      {
       "letter": "eu / äu",
       "example": "heute",
       "en": "oy — as in “boy”",
       "mouth": "*eu* and *äu* sound the same: *teuer, heute, die Bäume*."
      },
      {
       "letter": "a + h / aa",
       "example": "fahren",
       "en": "a — as in “father”",
       "mouth": "An *h* after a vowel is silent — it only makes the vowel **long**. Double vowels are long too: *Haare, leer*."
      },
      {
       "letter": "mm / ff / ss",
       "example": "offen",
       "none": true,
       "mouth": "Double consonant = the vowel **before** it is short and clipped: *kommen, offen, Wasser*."
      },
      {
       "letter": "sch",
       "example": "schön",
       "en": "sh — as in “shoe”",
       "mouth": "*schreiben, schön, deutsch*."
      },
      {
       "letter": "ch after a, o, u, au",
       "example": "das Buch",
       "none": true,
       "mouth": "Back of the tongue near the soft palate, air rubs through — like a soft clearing of the throat (Scottish *loch*). *machen, Buch, auch*."
      },
      {
       "letter": "ch after e, i, ä, ö, ü, consonants",
       "example": "ich",
       "none": true,
       "mouth": "Tongue high in the front like for *ee* (“see”) and blow air through — a soft hiss, like a cat. *ich, rechnen, Bücher*."
      },
      {
       "letter": "ck",
       "example": "der Drucker",
       "en": "k — as in “back”",
       "mouth": "*ck* = *k*; the vowel before it is short. *backen, Drucker*."
      }
     ]
    },
